/* SPDX-License-Identifier: MIT; exact main.c helpers with native fake devices. */
#include <assert.h>
#include <stdio.h>
#include <string.h>
#include <sandbox/abi.h>
#include "audio.h"
#include "session.h"
#include "menu.h"
#include "font.h"
#include "input.h"
#include "usbkbd.h"
#include "hidboot.h"
#include "usblog.h"
#include "ostune.h"

static uint32_t abi_minor = 8;
static void gl_add(const char *l, uint64_t t) {(void)l; (void)t;}
static int gl_flush(const void *o, uint64_t t, int f) {(void)o; (void)t; (void)f; return 0;}
static uint64_t now = 1000000000ull;
static struct gs_session game;
static struct gm_menu menu;
static uint8_t pic_px[64000];
static int bg_state; static uint64_t bg_next;
static void bg_leave(void);
static void heartbeat(void) {now += 1000000ull;}
static void audio_sleep_until(uint64_t wake) {now = wake;}
static void (*audio_hook)(void);
static char logs[8192];
static int32_t open_error, query_error, write_error;
static unsigned opens, closes, writes, queries;
static int opened, invalid_format;
static uint64_t capacity = 4096, queued, short_write;
static int nonzero;
static uint64_t clock_ns(void) {return now;}
static int32_t sbx_clock_ns(uint64_t *out) {*out = now; return 0;}
static void say(const char *line) {
  assert(strlen(logs) + strlen(line) + 2 < sizeof logs);
  strcat(logs, line); strcat(logs, "\n");
}
@FORMAT@
static int voc_open(const char *name, struct vp_io *io) {(void)name; (void)io; return -1;}
static int32_t sbx_open(const char *path, uint32_t n, uint32_t flags, uint64_t *fd) {
  assert(n == 10 && !memcmp(path, "/dev/audio", n) && flags == SBX_O_WRONLY);
  opens++; if (open_error) return open_error;
  assert(!opened); opened = 1; queued = 0; *fd = 17; return 0;
}
static int32_t sbx_close(uint64_t fd) {
  assert(fd == 17 && opened); opened = 0; closes++; queued = 0; return 0;
}
static int32_t sbx_ioctl(uint64_t fd, uint32_t op, void *record, uint32_t bytes) {
  assert(fd == 17 && opened && op == SBX_IOC_AUDIO_QUERY && bytes == sizeof(sbx_audio_info));
  sbx_audio_info *i = record;
  assert(i->h.size == bytes && !i->h.flags && !i->h.reserved0 && !i->h.reserved1);
  assert(!i->flags && !i->rate && !i->capacity_frames && !i->queued_frames &&
         !i->played_frames && !i->underruns && !i->overruns && !i->overrun_frames);
  queries++; if (query_error) return query_error;
  i->rate = invalid_format ? 44100 : SBX_AUDIO_RATE;
  i->capacity_frames = capacity; i->queued_frames = queued; return 0;
}
#define SBX_HEADER(type) {sizeof(type), 0, 0, 0}
@QUERY@
static int32_t sbx_write(uint64_t fd, const void *data, uint32_t bytes, uint64_t *done) {
  assert(fd == 17 && opened && bytes % 4 == 0);
  writes++; if (write_error) return write_error; /* leave done untouched, like SDK */
  *done = short_write ? short_write : bytes;
  const int16_t *pcm = data;
  for (unsigned i = 0; i < bytes / 2; i++) if (pcm[i]) nonzero = 1;
  if (*done <= bytes) queued += *done / 4;
  return 0;
}
@HELPERS@

/* Pinned usbkbd.c's log dependencies; its report decode and union are real. */
void log_line(const char *line);
void log_line(const char *line) {(void)line;}
void usblog_clear(void) {}
void usblog_add(const char *line) {(void)line;}
void usblog_fmt_note(char *out, uint8_t d, uint8_t idx, const char *text) {
  (void)d; (void)idx; (void)text; out[0] = 0;
}
static sbx_input_event events[128];
static unsigned count, cursor;
void input_add(void) {}
void input_remove(void) {}
int input_frame(const struct input_change *changes, unsigned n) {
  for (unsigned i = 0; i < n; i++) {
    assert(count < sizeof events / sizeof events[0]);
    events[count++] = (sbx_input_event){now, changes[i].type, changes[i].code, changes[i].value};
  }
  return 0;
}
int32_t sbx_read(uint64_t fd, void *out, uint32_t bytes, uint64_t *done);
int32_t sbx_read(uint64_t fd, void *out, uint32_t bytes, uint64_t *done) {
  assert(fd == 2);
  unsigned n = count - cursor;
  if (!n) return -SBX_EAGAIN;
  if (n > bytes / sizeof events[0]) n = bytes / sizeof events[0];
  memcpy(out, events + cursor, n * sizeof events[0]); cursor += n;
  *done = n * sizeof events[0]; return 0;
}
static struct gi_keys keys;
static unsigned toggles;
static void dispatch(int playing) {
  sbx_input_event batch[GI_BATCH]; uint32_t n;
  int32_t rc;
  while (!(rc = gi_read(2, batch, &n))) for (unsigned i = 0; i < n; i++) {
    if (!gi_accept(&keys, &batch[i], now)) continue;
    unsigned before = (unsigned)aud.music_muted;
    if (playing) {
      if (play_music_event(&batch[i])) {toggles += before != aud.music_muted; continue;}
      gs_event(&game, batch[i].type, batch[i].code, batch[i].value);
    } else {
      int a = gm_event(&menu, batch[i].type, batch[i].code, batch[i].value);
      int music_changed = 0, redraw = 0;
      @MENU_MUSIC@
      @MENU_APPLY@
      if (music_changed) {assert(redraw); toggles++;}
    }
  }
  assert(rc == -SBX_EAGAIN); count = cursor = 0;
}
static void report(unsigned device, int down) {
  /* Rii-like receiver with report ID 1; second keyboard plain boot report.
   * M may occupy any of the six usage slots. */
  uint8_t rii[9] = {1, 0, 0, 0, 0, 0, 0, 0, 0};
  uint8_t second[8] = {0};
  rii[8] = down ? 0x10 : 0; second[2] = down ? 0x10 : 0;
  assert(usbkbd_report((uint8_t)device, 0, device == 1 ? rii : second, device == 1 ? 9 : 8));
}
static void load_song(void) {
  assert(os_tune_len < sizeof bgm_buf);
  memcpy(bgm_buf, os_tune, os_tune_len);
  assert(!au_play_loaded(&aud, os_tune_len));
}
static int32_t read_song(void *user, const char *name, uint8_t *out, uint32_t cap) {
  (void)user; assert(!strcmp(name, "LATEST.CMF") && cap == sizeof pic_px && out == pic_px);
  memcpy(out, os_tune, os_tune_len); return (int32_t)os_tune_len;
}
static void fail_note(const char *expected) {
  assert(strstr(logs, expected));
  assert(audio_note_tick() && audio_note_until > now);
  uint16_t rgb16[40 * 220] = {0}; uint32_t rgb32[40 * 220] = {0};
  audio_note_draw(rgb16, 220, 0); audio_note_draw(rgb32, 220, 1);
  unsigned white16 = 0, white32 = 0;
  for (unsigned i = 0; i < 40 * 220; i++) {white16 += rgb16[i] == 0xffff; white32 += rgb32[i] == 0xffffff;}
  assert(white16 > 0 && white16 == white32); /* real text, both screen modes */
  now += 3000000000ull; assert(audio_note_tick() && !audio_note_until);
}
int main(void) {
  abi_minor = 7; audio_open(); assert(!opens && !aud_on);
  fail_note("requires ABI 1.8: error -38");
  abi_minor = 8; open_error = -SBX_ENODEV; audio_open();
  assert(!aud_on); fail_note("open /dev/audio: error -19");
  logs[0] = 0; music_feedback(0);
  assert(strstr(logs, "GMOS music off")); fail_note("open /dev/audio: error -19");
  open_error = -SBX_EBUSY; music_feedback(1);
  assert(strstr(logs, "GMOS music on")); fail_note("open /dev/audio: error -16");
  open_error = 0; query_error = -SBX_EIO; audio_open();
  assert(!aud_on && !opened && closes == 1); fail_note("query: error -5");
  query_error = 0; invalid_format = 1; audio_open();
  assert(!aud_on && !opened && closes == 2); fail_note("query format: error -22");
  invalid_format = 0; capacity = 0; audio_open(); assert(!aud_on && !opened);
  capacity = UINT64_MAX; audio_open(); assert(!aud_on && !opened);
  capacity = 4096; audio_open(); assert(aud_on && opened && audio_hook);
  audio_note_tick(); audio_log("test counters");
  query_error = -SBX_EBADF; unsigned before_writes = writes;
  music_feedback(1); assert(!aud_on && !opened && writes == before_writes);
  fail_note("query: error -9"); /* M probes a silent device before rendering */
  query_error = 0; music_feedback(1);
  load_song(); write_error = -SBX_EAGAIN; audio_poll();
  assert(aud_on && aud.hold_len && !audio_note_until);
  write_error = 0; short_write = 4; audio_poll(); assert(aud_on && queued);
  short_write = 0; queued = 0; write_error = -SBX_EIO; logs[0] = 0; audio_poll();
  assert(!aud_on && !opened && game.sound.event); fail_note("write: error -5");
  write_error = 0; music_feedback(1); assert(aud_on && opened && aud.music_pending);
  au_service(&aud, 0, 0); load_song(); queued = 0; query_error = -SBX_ENODEV; audio_poll();
  assert(!aud_on && !opened); fail_note("query: error -19");
  query_error = 0; music_feedback(1); load_song(); short_write = 3; audio_poll();
  assert(!aud_on && !opened); fail_note("write count: error -5");
  short_write = 0; music_feedback(1); load_song();
  /* Oversized transferred counts must never truncate into a valid write. */
  short_write = 1ull << 32; audio_poll(); assert(!aud_on && !opened);
  short_write = 0; music_feedback(1);
  puts("ABI, open, query, write, recovery and note PASS");

  usbkbd_init(); gi_reset(&keys);
  assert(usbkbd_hid_mounted(1, 0, true) && usbkbd_hid_mounted(2, 0, true));
  assert(usbkbd_count() == 2 && hidboot_linux_key(0x10) == 50);
  gm_finish(&menu); assert(menu.background_music);
  /* Both keyboards independently toggle in grid, details, and Options. */
  for (unsigned view = 0; view < 3; view++) for (unsigned d = 1; d <= 2; d++) {
    menu.view = view == 1 ? GM_DETAILS : GM_GRID; menu.options_active = view == 2;
    unsigned n = toggles; int before = menu.background_music;
    report(d, 1); dispatch(0); assert(toggles == n + 1 && menu.background_music != before);
    report(d, 1); dispatch(0); assert(toggles == n + 1); /* held report */
    report(d, 0); dispatch(0); assert(toggles == n + 1);
  }
  menu.options_active = 0;
  report(1, 1); dispatch(0); unsigned n = toggles;
  report(2, 1); dispatch(0); report(1, 0); dispatch(0);
  assert(toggles == n); /* union: neither a second press nor early release */
  report(2, 0); dispatch(0); report(2, 1); dispatch(0); assert(toggles == n + 1);
  usbkbd_hid_unmounted(2, 0); dispatch(0); assert(toggles == n + 1);
  assert(usbkbd_hid_mounted(2, 0, true));
  report(2, 0); dispatch(0);
  /* Search and folder name entry retain the letter M. */
  menu.search_active = 1; n = toggles; report(1, 1); dispatch(0); report(1, 0); dispatch(0);
  assert(toggles == n && !strcmp(menu.query, "m"));
  menu.search_active = 0; menu.open_active = 1;
  report(1, 1); dispatch(0); report(1, 0); dispatch(0);
  assert(toggles == n && !strcmp(menu.open_dir, "M")); menu.open_active = 0;
  /* Game M never becomes a card-skip, DOS menu key or a gameplay key. */
  const int phases[] = {GS_CARDS, GS_MENU, GS_PLAY, GS_PAUSED};
  for (unsigned phase = 0; phase < sizeof phases / sizeof phases[0]; phase++) for (unsigned d = 1; d <= 2; d++) {
    game.phase = phases[phase]; game.launcher = 1; game.keys = 0;
    aud.music_muted = 0; n = toggles;
    report(d, 1); dispatch(1); report(d, 0); dispatch(1);
    assert(toggles == n + 1 && aud.music_muted && !game.keys && game.phase == phases[phase]);
    sbx_input_event repeat = {now, SBX_EV_KEY, 50, 2};
    assert(play_music_event(&repeat) && aud.music_muted);
    report(d, 1); dispatch(1); report(d, 0); dispatch(1); assert(!aud.music_muted);
  }
  /* M while closed reports the retained error and retries on enabling. */
  load_song(); queued = 0; write_error = -SBX_EIO; audio_poll();
  open_error = -SBX_ENODEV; logs[0] = 0;
  report(1, 1); dispatch(1); report(1, 0); dispatch(1);
  assert(strstr(logs, "GMOS music off")); fail_note("write: error -5");
  report(2, 1); dispatch(1); report(2, 0); dispatch(1);
  assert(strstr(logs, "GMOS music on")); fail_note("open /dev/audio: error -19");
  /* A closed device must not leave the background cycle stuck in "playing". */
  menu.background_music = 1; bg_state = 1;
  report(1, 1); dispatch(0); report(1, 0); dispatch(0);
  assert(!menu.background_music && !bg_state);
  /* Buffer ownership and the latest song request survive unavailable audio. */
  assert(!aud_on); audio_take(); assert(aud.music == pic_px && !aud.music_muted);
  au_event(0, SND_EV_MUSIC, "OLD.CMF", 0);
  au_event(0, SND_EV_MUSIC, "LATEST.CMF", 0);
  open_error = write_error = 0; music_feedback(1);
  assert(aud_on && aud.music == pic_px && aud.music_pending);
  assert(au_service(&aud, read_song, 0) == 1 && aud.cmf.playing);
  bg_return("test return"); assert(aud.music == bgm_buf && !aud.want_music[0] && !aud.cmf.playing);
  puts("two keyboards, reports, menu and game M PASS");

  struct au a, b; static uint8_t ma[8192], mb[8192];
  au_init(&a, ma, sizeof ma); au_init(&b, mb, sizeof mb);
  memcpy(ma, os_tune, os_tune_len); memcpy(mb, os_tune, os_tune_len);
  assert(!au_play_loaded(&a, os_tune_len) && !au_play_loaded(&b, os_tune_len));
  a.music_muted = 1;
  int16_t mute[AU_CHUNK * 2], audible[AU_CHUNK * 2];
  for (unsigned j = 0; j < 20; j++) {
    au_render(&a, mute, AU_CHUNK); au_render(&b, audible, AU_CHUNK);
    for (unsigned k = 0; k < AU_CHUNK * 2; k++) assert(!mute[k]);
  }
  a.music_muted = 0; au_render(&a, mute, AU_CHUNK); au_render(&b, audible, AU_CHUNK);
  assert(!memcmp(mute, audible, sizeof mute)); /* unmute at the current song position */
  static uint8_t snd[2160];
  for (unsigned j = 0; j < 36; j++) {snd[j * 2] = 0xb8; snd[j * 2 + 1] = 1;}
  a.music_muted = 1; assert(!pc_start(&a.pc, snd, sizeof snd, 0));
  au_render(&a, mute, AU_CHUNK); nonzero = 0;
  for (unsigned k = 0; k < AU_CHUNK * 2; k++) if (mute[k]) nonzero = 1;
  assert(nonzero);
  puts("muted music advances; effects audible PASS");
  return 0;
}
